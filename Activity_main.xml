<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorLight"
            android:padding="12dp"
            android:text="How to use:\n1. Choose the month.\n2. Enter units used (1 - 1000 kWh).\n3. Slide to set your rebate (0% - 5%).\n4. Tap Calculate to see the bill, then Save to keep it.\n5. Tap History to view, edit or delete saved bills." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Month"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spMonth"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Electricity used (kWh)"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etUnits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 350"
            android:inputType="number"
            android:maxLength="4" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allowed range: 1 to 1000 kWh"
            android:textColor="#757575"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRebate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rebate: 0.0%"
            android:textStyle="bold" />
        <SeekBar
            android:id="@+id/sbRebate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="0" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_calculate"
            android:drawablePadding="8dp"
            android:text="Calculate"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/colorLight"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total charges: RM 0.00"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvFinal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Final cost after rebate: RM 0.00"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/colorAccent"
            android:drawableStart="@drawable/ic_save"
            android:drawablePadding="8dp"
            android:text="Save"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/colorPrimaryDark"
            android:drawableStart="@drawable/ic_history"
            android:drawablePadding="8dp"
            android:text="History"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
